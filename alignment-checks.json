{
  "schema_version": 1,
  "default_requirements": ["scripts/requirements-alignment.txt"],
  "checks": [
    {
      "name": "cylindrical-light-sheet",
      "description": "Cylindrical sheet thickness and range with independent ABCD and power checks",
      "argv": ["{python}", "cases/cylindrical-light-sheet/workflow.py", "--out", "{runs}/cylindrical-light-sheet"],
      "requirements": "cases/cylindrical-light-sheet/requirements-light-sheet.txt",
      "optional": true,
      "requires_python": "3.12",
      "expected_status": "PASS",
      "timeout": 180
    },
    {
      "name": "cylindrical-light-sheet-f40",
      "description": "A shorter focal length trades propagation range for a thinner sheet",
      "argv": ["{python}", "cases/cylindrical-light-sheet/workflow.py", "--out", "{runs}/cylindrical-light-sheet-f40", "--focal-length-mm", "40"],
      "requirements": "cases/cylindrical-light-sheet/requirements-light-sheet.txt",
      "optional": true,
      "requires_python": "3.12",
      "expected_status": "PASS",
      "timeout": 180
    },
    {
      "name": "phase-only-flat-top",
      "description": "Circular flat top and changed input width with a fixed phase mask",
      "argv": ["{python}", "cases/phase-only-flat-top/workflow.py", "--out", "{runs}/phase-only-flat-top"],
      "requirements": "cases/phase-only-flat-top/requirements-flat-top.txt",
      "optional": true,
      "requires_python": "3.12",
      "expected_status": "PASS",
      "timeout": 180
    },
    {
      "name": "bounded-aberration-correction",
      "description": "Intensity-only five-mode correction with independent polar quadrature",
      "argv": ["{python}", "cases/bounded-aberration-correction/workflow.py", "--out", "{runs}/bounded-aberration-correction"],
      "requirements": "cases/bounded-aberration-correction/requirements-aberration.txt",
      "optional": true,
      "requires_python": "3.12",
      "expected_status": "PASS",
      "timeout": 180
    },
    {
      "name": "bounded-aberration-correction-stronger",
      "description": "Stronger uncontrolled spherical aberration reduces recovered on-axis intensity",
      "argv": ["{python}", "cases/bounded-aberration-correction/workflow.py", "--out", "{runs}/bounded-aberration-correction-stronger", "--spherical-waves", "0.1"],
      "requirements": "cases/bounded-aberration-correction/requirements-aberration.txt",
      "optional": true,
      "requires_python": "3.12",
      "expected_status": "PASS",
      "timeout": 180
    },
    {
      "name": "kit-cli",
      "description": "Installed command lists its subcommands",
      "argv": ["{python}", "-m", "os_optics_kit", "--help"]
    },
    {
      "name": "offline-tests",
      "description": "Full test suite before the catalog is prepared; catalog tests skip themselves",
      "argv": ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests"],
      "timeout": 1200
    },
    {
      "name": "summary-missing-run",
      "description": "A missing run directory is a JSON error on stderr with exit 4",
      "argv": ["{python}", "-m", "os_optics_kit", "summary", "{runs}/no-such-run"],
      "expected_exit": 4,
      "json_error": true
    },
    {
      "name": "beam-summary",
      "description": "Catalog beam expander and saved-result summary comparison",
      "argv": ["{python}", "-m", "tests.check_beam_summary", "--project", "cases/beam-expander/project.json", "--out", "{runs}/beam"],
      "needs_catalog": true,
      "expected_status": "PASS"
    },
    {
      "name": "catalog-tests",
      "description": "Catalog-dependent tests, run after the catalog is prepared; a missing catalog fails them",
      "argv": ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_optical_designs.py::CatalogVariantTests", "tests/test_workflow_examples.py::CatalogBeamExpanderDemoTests", "tests/test_workflow_postprocess.py::CandidateTests"],
      "needs_catalog": true,
      "env": {"OS_OPTICS_KIT_REQUIRE_CATALOG": "1"},
      "timeout": 600
    },
    {
      "name": "cases-verify",
      "description": "Every case: project check, project run and results targets against expected.json",
      "argv": ["{python}", "-m", "os_optics_kit", "cases", "verify", "--all", "--out", "{runs}/cases"],
      "needs_catalog": true,
      "timeout": 3600
    },
    {
      "name": "saved-run-summary",
      "description": "Summarize the saved beam-expander run without simulating",
      "argv": ["{python}", "-m", "os_optics_kit", "summary", "{runs}/beam"],
      "needs": ["beam-summary"],
      "expected_status": "PASS"
    },
    {
      "name": "workflow-expansion",
      "description": "Beam expansion/focus workflow with a three-value gap study",
      "argv": ["{python}", "cases/expansion-focus/workflow.py", "--out", "{runs}/wf-expansion", "--study", "gap_error_mm=-2,0,2"],
      "expected_status": "PASS",
      "timeout": 300
    },
    {
      "name": "workflow-polarization-out-of-model",
      "description": "1064 nm lies outside the retarder band: affected targets are indeterminate, workflow OUT_OF_MODEL, exit 3",
      "argv": ["{python}", "cases/polarization-control/workflow.py", "--out", "{runs}/wf-pol-oom", "--no-studies", "--wavelength-nm", "1064"],
      "expected_exit": 3,
      "expected_status": "OUT_OF_MODEL"
    },
    {
      "name": "workflow-alignment-synthetic",
      "description": "Alignment with the labelled synthetic-measurement fit; a 1 mrad tilt misses the tolerance",
      "argv": ["{python}", "cases/mirror-alignment/workflow.py", "--out", "{runs}/wf-alignment-synthetic", "--no-studies", "--mirror-tilt-local-y-mrad", "1", "--synthetic-measurements"],
      "expected_exit": 1,
      "expected_status": "FAIL"
    },
    {
      "name": "spec-pol-design",
      "description": "Nominal polarization Project used as the sweep base",
      "argv": ["{python}", "cases/polarization-control/workflow.py", "--out", "{runs}/spec-pol", "--no-studies"],
      "expected_status": "PASS"
    },
    {
      "name": "spec-pol-sweep",
      "description": "HWP by wavelength sweep keeping OUT_OF_MODEL samples",
      "argv": ["{python}", "-m", "os_optics_kit", "sweep", "cases/polarization-control/studies/polarization_hwp_wavelength_sweep.json", "--base", "{runs}/spec-pol/nominal/project.json", "--out", "{runs}/spec-pol-sweep"],
      "needs": ["spec-pol-design"],
      "expected_status": "COMPLETED",
      "timeout": 300
    },
    {
      "name": "sensitivity-polarization",
      "description": "Finite-difference sensitivity of transmitted power, two steps per parameter",
      "argv": ["{python}", "-m", "os_optics_kit", "sensitivity", "cases/polarization-control/studies/sensitivity_polarization.json", "--out", "{runs}/sensitivity-polarization", "--no-plots", "--no-report"],
      "expected_status": "COMPLETED",
      "timeout": 300
    },
    {
      "name": "tolerance-polarization",
      "description": "Seeded tolerance sampling, 20 samples, out-of-model samples counted",
      "argv": ["{python}", "-m", "os_optics_kit", "tolerance", "cases/polarization-control/studies/tolerance_polarization.json", "--out", "{runs}/tolerance-polarization", "--samples", "20", "--no-plots", "--no-report"],
      "expected_status": "COMPLETED",
      "timeout": 300
    },
    {
      "name": "tolerance-polarization-workers",
      "description": "The same tolerance study in two worker processes; results equal the serial study",
      "argv": ["{python}", "-m", "os_optics_kit", "tolerance", "cases/polarization-control/studies/tolerance_polarization.json", "--out", "{runs}/tolerance-polarization-workers", "--samples", "20", "--no-plots", "--no-report", "--workers", "2"],
      "expected_status": "COMPLETED",
      "timeout": 300
    },
    {
      "name": "study-resume",
      "description": "Resume of the completed tolerance study: every sample is reused, nothing runs again",
      "argv": ["{python}", "-m", "os_optics_kit", "study", "run", "{runs}/tolerance-polarization", "--resume"],
      "needs": ["tolerance-polarization"],
      "expected_status": "COMPLETED",
      "timeout": 300
    },
    {
      "name": "catalog-candidates",
      "description": "Bounded candidate table of plano-convex lenses at 780 nm",
      "argv": ["{python}", "-m", "os_optics_kit", "candidates", "--category", "LENS", "--form", "PLANO_CONVEX_LENS", "--wavelength-nm", "780", "--range", "focal_length_mm=95..105", "--near", "focal_length_mm=100", "--limit", "5"],
      "needs_catalog": true,
      "expected_status": "COMPLETED"
    },
    {
      "name": "spec-be-swap",
      "description": "Swap L2 of the saved beam expander for the 100.3 mm candidate: expanded_waist FAIL",
      "argv": ["{python}", "-m", "os_optics_kit", "edit", "{runs}/beam/project.json", "--edits", "cases/beam-expander/studies/beam_expander_swap_l2.json", "--out", "{runs}/spec-be-swapped.json", "--run", "{runs}/spec-be-swapped-run"],
      "needs": ["beam-summary"],
      "needs_catalog": true,
      "expected_exit": 1,
      "expected_status": "FAIL"
    },
    {
      "name": "spec-be-sweep",
      "description": "L2 spacing sweep; best shift 0.54 mm",
      "argv": ["{python}", "-m", "os_optics_kit", "sweep", "cases/beam-expander/studies/beam_expander_l2_sweep.json", "--base", "{runs}/spec-be-swapped.json", "--out", "{runs}/spec-be-sweep"],
      "needs": ["spec-be-swap"],
      "needs_catalog": true,
      "expected_status": "COMPLETED",
      "timeout": 300
    },
    {
      "name": "spec-be-move",
      "description": "Move L2 by 540 um: PASS",
      "argv": ["{python}", "-m", "os_optics_kit", "edit", "{runs}/spec-be-swapped.json", "--edits", "cases/beam-expander/studies/beam_expander_move_l2.json", "--out", "{runs}/spec-be-final.json", "--run", "{runs}/spec-be-final-run"],
      "needs": ["spec-be-swap"],
      "needs_catalog": true,
      "expected_status": "PASS"
    },
    {
      "name": "spec-be-compare",
      "description": "Compare base, swapped and final runs with freshness against the final Project",
      "argv": ["{python}", "-m", "os_optics_kit", "compare", "{runs}/beam", "{runs}/spec-be-swapped-run", "{runs}/spec-be-final-run", "--project", "{runs}/spec-be-final.json", "--out", "{runs}/spec-be-compare"],
      "needs": ["spec-be-move"],
      "needs_catalog": true,
      "expected_status": "COMPLETED"
    },
    {
      "name": "spec-be-plot",
      "description": "Sweep curve of expanded_waist with outcome markers",
      "argv": ["{python}", "-m", "os_optics_kit", "plot", "sweep", "{runs}/spec-be-sweep", "--y", "target:expanded_waist"],
      "needs": ["spec-be-sweep"],
      "needs_catalog": true,
      "expected_status": "COMPLETED"
    },
    {
      "name": "spec-be-report",
      "description": "Study report with plots, edit record and freshness",
      "argv": ["{python}", "-m", "os_optics_kit", "report", "{runs}/spec-be-sweep", "--project", "{runs}/spec-be-final.json", "--plots", "{runs}/spec-be-sweep/plots", "--changes", "{runs}/spec-be-swapped.changes.json"],
      "needs": ["spec-be-plot", "spec-be-move"],
      "needs_catalog": true,
      "expected_status": "COMPLETED"
    },
    {
      "name": "tolerance-verify-seed",
      "description": "Redraw the tolerance samples from the recorded seed",
      "argv": ["{python}", "-m", "os_optics_kit", "tolerance", "--verify-seed", "{runs}/tolerance-polarization"],
      "needs": ["tolerance-polarization"],
      "optional": true,
      "expected_status": "REPRODUCED"
    },
    {
      "name": "tolerance-zero",
      "description": "Zero tolerance reproduces the nominal Project and result",
      "argv": ["{python}", "-m", "os_optics_kit", "tolerance", "cases/expansion-focus/studies/tolerance_expander.json", "--out", "{runs}/tolerance-zero", "--zero-tolerance", "--samples", "3", "--no-plots", "--no-report"],
      "optional": true,
      "expected_status": "COMPLETED"
    },
    {
      "name": "sensitivity-band-edge",
      "description": "Band-edge sensitivity: nominal FAIL kept, the out-of-model side gives a one-sided estimate",
      "argv": ["{python}", "-m", "os_optics_kit", "sensitivity", "cases/expansion-focus/studies/sensitivity_expander_band_edge.json", "--out", "{runs}/sensitivity-band-edge", "--no-plots", "--no-report"],
      "optional": true,
      "expected_status": "COMPLETED"
    },
    {
      "name": "workflow-expansion-full",
      "description": "Beam expansion/focus workflow, default studies",
      "argv": ["{python}", "cases/expansion-focus/workflow.py", "--out", "{runs}/wf-expansion-full"],
      "optional": true,
      "expected_status": "PASS",
      "timeout": 300
    },
    {
      "name": "workflow-expansion-unmet",
      "description": "Strict spot bound (10 um) must report FAIL with exit 1",
      "argv": ["{python}", "cases/expansion-focus/workflow.py", "--out", "{runs}/wf-expansion-unmet", "--no-studies", "--max-spot-radius-mm", "10um"],
      "optional": true,
      "expected_exit": 1,
      "expected_status": "FAIL"
    },
    {
      "name": "workflow-budget-refused",
      "description": "Study budget exceeded: JSON error, exit 4, nothing run",
      "argv": ["{python}", "cases/expansion-focus/workflow.py", "--out", "{runs}/wf-budget", "--max-evaluations", "5"],
      "optional": true,
      "expected_exit": 4,
      "json_error": true
    },
    {
      "name": "workflow-polarization-full",
      "description": "Polarization workflow, default studies",
      "argv": ["{python}", "cases/polarization-control/workflow.py", "--out", "{runs}/wf-polarization-full"],
      "optional": true,
      "expected_status": "PASS",
      "timeout": 300
    },
    {
      "name": "workflow-alignment-full",
      "description": "Alignment workflow, default studies",
      "argv": ["{python}", "cases/mirror-alignment/workflow.py", "--out", "{runs}/wf-alignment-full"],
      "optional": true,
      "expected_status": "PASS",
      "timeout": 300
    },
    {
      "name": "spec-pol-edit",
      "description": "Threshold edit in mW, validated and run",
      "argv": ["{python}", "-m", "os_optics_kit", "edit", "{runs}/spec-pol/nominal/project.json", "--edits", "cases/polarization-control/studies/polarization_threshold.json", "--out", "{runs}/spec-pol-strict.json", "--run", "{runs}/spec-pol-strict-run"],
      "needs": ["spec-pol-design"],
      "optional": true,
      "expected_status": "PASS"
    },
    {
      "name": "spec-pol-edit-retry",
      "description": "Repeating the same edit reports already_applied and reuses the current run",
      "argv": ["{python}", "-m", "os_optics_kit", "edit", "{runs}/spec-pol/nominal/project.json", "--edits", "cases/polarization-control/studies/polarization_threshold.json", "--out", "{runs}/spec-pol-strict.json", "--run", "{runs}/spec-pol-strict-run"],
      "needs": ["spec-pol-edit"],
      "optional": true,
      "expected_status": "PASS"
    },
    {
      "name": "interop-optimization",
      "description": "SciPy, Optuna and SALib loop over a catalog-free Project",
      "argv": ["{python}", "cases/interop-optimization/optimize_expander.py", "--out", "{runs}/interop-optimization"],
      "requirements": "cases/interop-optimization/requirements-optimization.txt",
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "WITHIN_TOLERANCE",
      "timeout": 1800
    },
    {
      "name": "interop-diffraction-handoff",
      "description": "Engine transverse-plane handoffs for three stop radii",
      "argv": ["{python}", "cases/interop-diffraction/opensci_handoff.py", "--out", "{runs}/interop-diffraction"],
      "requirements": "cases/interop-diffraction/requirements-diffraction.txt",
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 900
    },
    {
      "name": "interop-diffraction-external",
      "description": "LightPipes, prysm and POPPY propagation of the handoffs",
      "argv": ["{python}", "cases/interop-diffraction/external_focus.py", "{runs}/interop-diffraction"],
      "requirements": "cases/interop-diffraction/requirements-diffraction.txt",
      "needs": ["interop-diffraction-handoff"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "WITHIN_TOLERANCE",
      "timeout": 1800
    },
    {
      "name": "interop-quantum-layouts",
      "description": "Catalog-free layouts exported as linear optical networks",
      "argv": ["{python}", "cases/interop-quantum/build_layouts.py", "--out", "{runs}/interop-quantum"],
      "requirements": "cases/interop-quantum/requirements-quantum.txt",
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 900
    },
    {
      "name": "interop-quantum-simulation",
      "description": "Perceval and Piquasso on the exported networks",
      "argv": ["{python}", "cases/interop-quantum/run_quantum.py", "{runs}/interop-quantum", "--inputs", "cases/interop-quantum/quantum_inputs.json"],
      "requirements": "cases/interop-quantum/requirements-quantum.txt",
      "needs": ["interop-quantum-layouts"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "WITHIN_TOLERANCE",
      "timeout": 900
    },
    {
      "name": "interop-metasurface-unit-cells",
      "description": "grcwa unit-cell library",
      "argv": ["{python}", "cases/interop-metasurface/step1_unit_cells.py", "--out", "{runs}/interop-metasurface"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 1800
    },
    {
      "name": "interop-metasurface-focusing",
      "description": "Angular-spectrum focusing of the metalens",
      "argv": ["{python}", "cases/interop-metasurface/step2_focusing.py", "{runs}/interop-metasurface"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "needs": ["interop-metasurface-unit-cells"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 1800
    },
    {
      "name": "interop-metasurface-unit-cells-ng201",
      "description": "grcwa unit cells at 201 orders for the convergence spread",
      "argv": ["{python}", "cases/interop-metasurface/step1_unit_cells.py", "--out", "{runs}/interop-metasurface", "--nG", "201", "--wavelengths-nm", "490", "515", "532", "545", "580"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "needs": ["interop-metasurface-unit-cells"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 1800
    },
    {
      "name": "interop-metasurface-focusing-ng201",
      "description": "Focusing from the 201-order library (convergence spread)",
      "argv": ["{python}", "cases/interop-metasurface/step2_focusing.py", "{runs}/interop-metasurface", "--nG", "201"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "needs": ["interop-metasurface-unit-cells-ng201"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 1800
    },
    {
      "name": "interop-metasurface-focusing-n2048",
      "description": "Focusing on a 2048-sample grid (convergence spread)",
      "argv": ["{python}", "cases/interop-metasurface/step2_focusing.py", "{runs}/interop-metasurface", "--samples", "2048", "--wavelengths-nm", "490", "515", "532", "545", "580"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "needs": ["interop-metasurface-unit-cells"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 3600
    },
    {
      "name": "interop-metasurface-model",
      "description": "Fit the tabulated metalens model",
      "argv": ["{python}", "cases/interop-metasurface/step3_fit_model.py", "{runs}/interop-metasurface"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "needs": ["interop-metasurface-focusing", "interop-metasurface-focusing-ng201", "interop-metasurface-focusing-n2048"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "COMPLETED",
      "timeout": 900
    },
    {
      "name": "interop-metasurface-engine-check",
      "description": "Engine run of the fitted model against the external focus tables",
      "argv": ["{python}", "cases/interop-metasurface/step4_engine_check.py", "{runs}/interop-metasurface"],
      "requirements": "cases/interop-metasurface/requirements-metasurface.txt",
      "needs": ["interop-metasurface-model"],
      "optional": true,
      "requires_python": "3.12",
      "status_field": "outcome",
      "expected_status": "WITHIN_TOLERANCE",
      "timeout": 900
    }
  ]
}
